rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@yes.edu.co'];
    }

    // Public read + list for all assets
    match /{allPaths=**} {
      allow read: if true;
      // Admins can delete any file — delete has no request.resource so must be separate
      allow delete: if isAdmin();
    }

    // Images — max 5 MB
    match /blog-images/{filename} {
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /uploads/{filename} {
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /yes-factor-winners/{filename} {
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Videos — max 200 MB
    match /yes-factor-videos/{filename} {
      allow create, update: if isAdmin()
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Documents (PDF) — max 20 MB
    match /yes-factor-docs/{filename} {
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
