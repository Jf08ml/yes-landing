rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // siteConfig: public read, admin-only write
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'admin@yes.edu.co'
        ];
    }

    // leads: anyone can create (via API), only admins can read/update/delete
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null
        && request.auth.token.email in [
          'admin@yes.edu.co'
        ];
    }

    // blogPosts: public read, admin-only write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'admin@yes.edu.co'
        ];
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
